EMPLOYEE_ACTIVE_CARD_CUSTOMER_UUID=
EMPLOYEE_CARD_BLOCK_STATUS=stop
ALLOW_MUTATING_CARD_TESTS=false

# Optional duplicate-token checks. Use disposable prepared employees.
